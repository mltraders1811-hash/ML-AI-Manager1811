# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Env files - never commit real secrets
.env
.env.local
.env*.local

# Sync pipeline scratch space
.tmp/
*.vyb
*.vyp

# Logs
npm-debug.log*
*.log

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Prisma
prisma/dev.db

# --- Android app ---
# Build output and machine-local SDK paths; the project itself is committed
# so a build needs nothing but this repo and a JDK.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
# Signing material never belongs in a repository.
android/keystore.properties
android/app/*.jks
android/app/*.keystore
