# --- Database (Neon free-tier Postgres, or any Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- V1 hardcoded tenant ---
# A fixed UUID for the single company this deployment serves. Generate one
# with `node -e "console.log(crypto.randomUUID())"` and keep it stable -
# prisma/seed.ts uses this to create the Company row, and the app/sync
# scripts use it as the tenant for every read/write.
DEFAULT_COMPANY_ID="00000000-0000-0000-0000-000000000001"

# --- Dashboard login (single admin, V1) ---
ADMIN_USERNAME=""
# Plain password used only to derive ADMIN_PASSWORD_HASH below - not read at
# runtime. Keep this out of version control once set.
ADMIN_PASSWORD_HASH="" # generate with: node scripts/hash-password.mjs <password>
SESSION_SECRET="" # random 32+ byte string, e.g. `openssl rand -base64 32`

# --- Google Drive (service account) ---
# Share the backup folder in Google Drive with the service account's email
# (client_email in the JSON key) as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON="" # the full service-account JSON key, as one line
GDRIVE_BACKUP_FOLDER_ID="" # the Google Drive folder ID that receives daily .vyb backups

# --- Bank statements (optional, enables the daily automatic pickup) ---
# A second Google Drive folder, shared with the same service account, that
# receives bank statement files (.csv/.xlsx). Most net-banking portals can
# email or export a statement on a schedule; drop those files here (Gmail
# filter -> Drive, or the bank's own scheduled export) and the daily sync
# reads whatever is new, reconciles it, and leaves anything it can't
# identify on the /bank screen to be named. Leave blank to use uploads only -
# the Bank screen still works, you just pick the file yourself.
GDRIVE_BANK_STATEMENT_FOLDER_ID=""

# --- AI chat assistant ---
ANTHROPIC_API_KEY=""

# --- "Sync Now" button (optional) ---
# Fine-grained GitHub PAT scoped to this repo with "Actions: Read and write"
# permission, used only to trigger the daily-sync workflow on demand from
# the dashboard. Leave blank to just use the 08:30 IST daily schedule.
GITHUB_SYNC_TOKEN=""

# --- Phone notifications (optional) ---
# Web-push keys. Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys(),null,2))"
# The same pair must be set in Vercel (so a browser can subscribe) AND as
# GitHub Actions secrets (so the daily sync can send). Leave blank to run
# without notifications - everything else works the same.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="" # optional contact address, e.g. mailto:you@example.com

# --- Business rules ---
# If a Vyapar transaction has no explicit due date, treat it as due this
# many days after the invoice date. Adjust to match your actual credit terms.
DEFAULT_PAYMENT_TERMS_DAYS="15"
