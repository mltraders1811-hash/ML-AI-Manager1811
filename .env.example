# --- Database (Neon free-tier Postgres, or any Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- V1 hardcoded tenant ---
# A fixed UUID for the single company this deployment serves. Generate one
# with `node -e "console.log(crypto.randomUUID())"` and keep it stable -
# prisma/seed.ts uses this to create the Company row, and the app/sync
# scripts use it as the tenant for every read/write.
DEFAULT_COMPANY_ID="00000000-0000-0000-0000-000000000001"

# --- Dashboard login (single admin, V1) ---
# Plain passcode used only to derive ADMIN_PASSCODE_HASH below - not read at
# runtime. Keep this out of version control once set.
ADMIN_PASSCODE_HASH="" # bcrypt hash - generate with: node scripts/hash-passcode.mjs <passcode>
SESSION_SECRET="" # random 32+ byte string, e.g. `openssl rand -base64 32`

# --- Google Drive (service account) ---
# Share the backup folder in Google Drive with the service account's email
# (client_email in the JSON key) as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON="" # the full service-account JSON key, as one line
GDRIVE_BACKUP_FOLDER_ID="" # the Google Drive folder ID that receives daily .vyb backups

# --- AI chat assistant ---
ANTHROPIC_API_KEY=""

# --- "Sync Now" button (optional) ---
# Fine-grained GitHub PAT scoped to this repo with "Actions: Read and write"
# permission, used only to trigger the daily-sync workflow on demand from
# the dashboard. Leave blank to just use the 08:30 IST daily schedule.
GITHUB_SYNC_TOKEN=""

# --- Business rules ---
# If a Vyapar transaction has no explicit due date, treat it as due this
# many days after the invoice date. Adjust to match your actual credit terms.
DEFAULT_PAYMENT_TERMS_DAYS="15"
