// M.L AI Manager - multi-tenant schema.
//
// V1 runs a single hardcoded company (see DEFAULT_COMPANY_ID in .env), but
// every business table carries companyId from day one so adding real
// multi-tenancy later is a matter of removing the hardcoded default, not a
// schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  customers      Customer[]
  invoices       Invoice[]
  inventoryItems InventoryItem[]
  syncRuns       SyncRun[]

  brokerageReports  BrokerageReport[]
  brokeragePayments BrokeragePayment[]

  overdueSettings       OverdueSettings?
  invoiceDesignSettings InvoiceDesignSettings?
  reminderLogs          ReminderLog[]
  pushSubscriptions     PushSubscription[]
  pushDigests           PushDigest[]

  bankAccounts     BankAccount[]
  bankImports      BankStatementImport[]
  bankTransactions BankTransaction[]
  bankMatchRules   BankMatchRule[]
  bankAlerts       BankAlertLog[]
}

model Customer {
  id        String @id @default(uuid())
  companyId String

  // Primary key of the row in Vyapar's kb_names table - lets sync re-run
  // idempotently instead of creating duplicates every day.
  externalId String

  name    String
  phone   String? // used to build the WhatsApp reminder deep link
  email   String?
  address String?

  // Vyapar's own running balance for this party (kb_names.amount), synced
  // as-is rather than derived from our own invoice/payment records. Vyapar
  // links payments to specific invoices in a separate table and never
  // updates the invoice's own balance field to reflect it, so summing
  // Invoice.balanceAmount silently overstates debt (verified against real
  // data: 10-27x too high per customer). This field is Vyapar's own
  // already-correct total and is what Total Outstanding/Overdue are
  // computed from - see src/lib/metrics.ts.
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  // Grace period after the invoice date before a bill counts as overdue.
  // Null means "use the company-wide default" (OverdueSettings.creditDays) -
  // stored per customer because terms genuinely differ per party.
  creditDays Int?
  // Free-text note kept alongside the phone number in the phone book.
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id])
  invoices  Invoice[]
  reminders ReminderLog[]

  bankTransactions BankTransaction[]
  bankMatchRules   BankMatchRule[]

  @@unique([companyId, externalId])
  @@index([companyId, name])
}

// Look and wording of the generated invoice PDF. One row per company;
// absent means "use the built-in defaults" (see src/lib/invoicePdf.ts).
model InvoiceDesignSettings {
  companyId String @id

  businessName  String
  addressLine   String?
  phone         String?
  gstin         String?
  // Hex colour used for the header band and table headings.
  accentColor   String  @default("#2B5336")
  // Free text printed at the bottom of every invoice (terms, thanks, etc).
  footerNote    String?
  showLineItems Boolean @default(true)

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

// One row each time a WhatsApp reminder is sent, so the overdue screen can
// show who has already been chased and how recently. Without it the list
// says nothing about follow-up, and the same party gets messaged twice in a
// morning while another is quietly forgotten.
//
// balanceAtSend records what they owed at the time: comparing it to what
// they owe now is what tells you whether the reminder actually worked.
model ReminderLog {
  id        String @id @default(uuid())
  companyId String

  customerId String
  sentAt     DateTime @default(now())

  balanceAtSend     Decimal @db.Decimal(14, 2)
  overdueAtSend     Decimal @db.Decimal(14, 2)
  daysOverdueAtSend Int

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId, sentAt])
  @@index([companyId, sentAt])
}

// Company-wide collections settings: the fallback credit period and the
// WhatsApp reminder wording. One row per company.
model OverdueSettings {
  companyId String @id

  creditDays       Int    @default(25)
  reminderTemplate String

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

enum InvoiceType {
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  PAYMENT_IN
  PAYMENT_OUT
  // Vyapar's "Receivable opening balance" (txn_type 5): what a party already
  // owed when the books were opened, before any invoice in this backup. One
  // per party, dated the start of the financial year. Counts as receivable
  // debt like a sale does - see getOverdueCustomers in src/lib/overdue.ts.
  OPENING_BALANCE
  OTHER
}

model Invoice {
  id        String @id @default(uuid())
  companyId String

  // Primary key of the row in Vyapar's kb_transactions table.
  externalId String

  customerId String
  type       InvoiceType

  invoiceNumber String?
  invoiceDate   DateTime
  // Nullable: Vyapar may not store an explicit due date. The sync engine
  // falls back to invoiceDate + DEFAULT_PAYMENT_TERMS_DAYS when absent -
  // see src/lib/sync/syncEngine.ts.
  dueDate       DateTime?

  totalAmount   Decimal @db.Decimal(14, 2)
  paidAmount    Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
  customer  Customer          @relation(fields: [customerId], references: [id])
  lineItems InvoiceLineItem[]

  @@unique([companyId, externalId])
  @@index([companyId, type, dueDate])
  @@index([companyId, type, invoiceDate])
}

model InvoiceLineItem {
  id        String @id @default(uuid())
  companyId String

  // Primary key of the row in Vyapar's kb_lineitems table.
  externalId String

  invoiceId String

  itemName  String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalId])
  @@index([companyId, invoiceId])
}

// Synced in the background for V1 (no UI yet) so the AI chat assistant and
// a future inventory screen can use it without another schema change.
model InventoryItem {
  id        String @id @default(uuid())
  companyId String

  // Primary key of the row in Vyapar's kb_item table.
  externalId String

  name          String
  currentStock  Decimal? @db.Decimal(14, 3)
  salePrice     Decimal? @db.Decimal(14, 2)
  purchasePrice Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, externalId])
}

enum SyncStatus {
  SUCCESS
  FAILED
}

// One row per daily pipeline run - lets the dashboard show "last synced X
// ago" and gives us an audit trail when a Vyapar backup fails to parse.
model SyncRun {
  id        String @id @default(uuid())
  companyId String

  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  status     SyncStatus?

  sourceFileName String?

  customersUpserted Int @default(0)
  invoicesUpserted  Int @default(0)
  lineItemsUpserted Int @default(0)
  inventoryUpserted Int @default(0)

  errorMessage String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, startedAt])
}

// ---------- Brokerage tracking ----------
// A second, unrelated feature: splitting an uploaded raw "Sale Report"
// Excel broker-wise and tracking brokerage (commission) owed to each
// broker. Distinct business domain from the Vyapar customer-dues tracking
// above (a broker earns commission on sales regardless of which customer
// bought), so it gets its own tables rather than reusing Customer/Invoice.

enum BrokerageReportSource {
  UPLOAD // manually uploaded Sale Report Excel
  VYAPAR_SYNC // derived automatically from the daily Vyapar backup
}

model BrokerageReport {
  id        String @id @default(uuid())
  companyId String

  filename   String
  fileSize   Int
  uploadedAt DateTime              @default(now())
  month      String? // YYYY-MM, detected from the most common transaction date
  source     BrokerageReportSource @default(UPLOAD)

  totalTransactions Int
  totalAmount       Decimal @db.Decimal(14, 2)
  totalBrokerage    Decimal @db.Decimal(14, 2)
  brokerCount       Int
  shopOwnCount      Int

  company  Company                  @relation(fields: [companyId], references: [id])
  brokers  BrokerageBrokerSummary[]
  payments BrokeragePayment[]

  // One derived report per month, kept stable across daily re-syncs so
  // BrokeragePayment rows (linked by reportId) survive re-derivation -
  // see upsertDerivedReport in src/lib/brokerage/reportService.ts.
  @@unique([companyId, month, source])
  @@index([companyId, uploadedAt])
  @@index([companyId, month])
}

model BrokerageBrokerSummary {
  id        String @id @default(uuid())
  companyId String
  reportId  String

  name             String
  isShopOwn        Boolean @default(false)
  totalQty         Decimal @db.Decimal(14, 2)
  totalAmount      Decimal @db.Decimal(14, 2)
  totalBrokerage   Decimal @db.Decimal(14, 2)
  transactionCount Int

  report       BrokerageReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  transactions BrokerageTransaction[]

  @@unique([reportId, name])
}

model BrokerageTransaction {
  id              String @id @default(uuid())
  companyId       String
  brokerSummaryId String

  date      String // as originally written, e.g. "05/08/2026"
  dateIso   String? // YYYY-MM-DD, used for analytics
  party     String
  item      String
  quantity  Decimal @db.Decimal(14, 3)
  price     Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)
  brokerage Decimal @db.Decimal(14, 2)

  brokerSummary BrokerageBrokerSummary @relation(fields: [brokerSummaryId], references: [id], onDelete: Cascade)

  @@index([companyId, brokerSummaryId])
}

model BrokeragePayment {
  id        String @id @default(uuid())
  companyId String
  reportId  String

  broker String
  amount Decimal @db.Decimal(14, 2)
  note   String?
  paidOn String // YYYY-MM-DD

  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  report  BrokerageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([companyId, reportId])
}

/**
 * One browser that has agreed to receive notifications. A person can have
 * several (phone, laptop), and a subscription dies silently when they clear
 * site data or reinstall - the push service then answers 404/410, which is
 * the only reliable signal to drop the row.
 */
model PushSubscription {
  id        String @id @default(uuid())
  companyId String

  /**
   * The push service URL. Unique because it IS the subscription's
   * identity - re-subscribing on the same browser returns the same
   * endpoint, and inserting again would double every notification.
   */
  endpoint String @unique
  p256dh   String
  auth     String

  /**
   * Shown in settings so the owner can tell one device from another when
   * revoking.
   */
  label      String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

/**
 * A record that the daily digest went out, keyed by IST calendar day. The
 * unique constraint is the dedupe: a sync that runs twice in a day (a
 * retry, a manual Sync Now) must not buzz the phone twice.
 */
model PushDigest {
  id        String @id @default(uuid())
  companyId String

  /**
   * IST date as YYYY-MM-DD.
   */
  dayKey    String
  title     String
  body      String
  sentCount Int
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, dayKey])
}

// ---------- Bank reconciliation ----------
// Money actually landing in the bank, reconciled against the parties in the
// phone book. Vyapar knows what each party was billed; only the bank knows
// what turned up, and a bank narration says "UPI/CR/4471/SHARMA TRAD" - not
// which customer that is. These tables hold each statement line, who it was
// finally decided to belong to, and the counterparty->customer rules learnt
// from those decisions so the same payer is recognised automatically next
// time.
//
// Deliberately a ledger of its own: it never writes back to Invoice or
// Customer.currentBalance, both of which are rebuilt from Vyapar on every
// sync and would silently overwrite anything recorded here.

enum BankTxnDirection {
  CREDIT // money in - a customer payment, until decided otherwise
  DEBIT // money out - supplier payment, charges, self transfer
}

enum BankTxnStatus {
  UNMATCHED // nobody knows whose this is yet
  SUGGESTED // the matcher has a guess worth showing, not sure enough to apply
  MATCHED // assigned to a customer
  IGNORED // decided not to be a customer payment
}

enum BankMatchSource {
  AUTO_RULE // a learnt counterparty -> customer rule fired
  AUTO_NAME // the narration named the customer closely enough
  MANUAL // a person tapped the customer
}

enum BankImportSource {
  UPLOAD // statement file picked from the phone
  DRIVE // statement file the bank/an automation drops in Google Drive
  API // statement file posted to the ingest webhook by some other automation
}

/// Where a line came from. A statement is the bank's own record and is
/// authoritative; an alert (a credit SMS or email, forwarded to the ingest
/// webhook) arrives within seconds of the payment but is provisional - the
/// statement line for the same payment supersedes it, carrying over whoever
/// it was already assigned to.
enum BankTxnOrigin {
  STATEMENT
  ALERT
}

model BankAccount {
  id        String @id @default(uuid())
  companyId String

  bankName     String
  label        String
  /// Last 4 digits as printed on the statement. Empty string (not null)
  /// when the statement never says, so the unique constraint below still
  /// applies - Postgres treats NULLs as distinct and would let duplicate
  /// accounts pile up.
  accountLast4 String @default("")

  createdAt DateTime @default(now())

  company      Company               @relation(fields: [companyId], references: [id])
  imports      BankStatementImport[]
  transactions BankTransaction[]

  @@unique([companyId, bankName, accountLast4])
}

/// One statement file read in, whether uploaded from the phone or picked up
/// from Drive. Keeps the counts that let the app say "142 lines, 9 new" and
/// - through externalId - stops the daily job re-reading the same file.
model BankStatementImport {
  id        String  @id @default(uuid())
  companyId String
  /// Null only for a file that could not be parsed at all - which account
  /// it belonged to is exactly what such a file never got as far as saying.
  /// The row is still written, so the daily job doesn't retry the same
  /// unreadable file every morning.
  accountId String?

  source     BankImportSource @default(UPLOAD)
  filename   String
  fileSize   Int
  importedAt DateTime         @default(now())

  /// Google Drive file id for DRIVE imports; null for uploads.
  externalId String?

  rowsParsed    Int @default(0)
  rowsImported  Int @default(0)
  rowsDuplicate Int @default(0)
  autoMatched   Int @default(0)

  periodStart DateTime?
  periodEnd   DateTime?

  errorMessage String?

  company      Company           @relation(fields: [companyId], references: [id])
  account      BankAccount?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([companyId, externalId])
  @@index([companyId, importedAt])
}

model BankTransaction {
  id        String  @id @default(uuid())
  companyId String
  accountId String
  importId  String?

  /// UTC midnight of the statement's calendar date, matching how invoice
  /// dates are stored (see src/lib/dateIst.ts).
  txnDate      DateTime
  valueDate    DateTime?
  description  String
  reference    String?
  direction    BankTxnDirection
  /// Always positive; direction carries the sign.
  amount       Decimal          @db.Decimal(14, 2)
  balanceAfter Decimal?         @db.Decimal(14, 2)

  /// Hash of the statement line (date, amount, direction, narration, and
  /// its position among identical lines that same day). Statements overlap
  /// - last month's file re-downloaded next month repeats every row - so
  /// this is what makes importing the same period twice a no-op.
  fingerprint String

  /// The other party as pulled out of the narration ("SHARMA TRADERS" from
  /// "UPI/CR/4471/SHARMA TRADERS/HDFC"), and its normalised form, which is
  /// what BankMatchRule and the matcher key on.
  counterparty    String?
  counterpartyKey String?

  origin          BankTxnOrigin    @default(STATEMENT)
  status          BankTxnStatus    @default(UNMATCHED)
  customerId      String?
  matchedBy       BankMatchSource?
  /// 0-100. How sure the matcher was; 100 once a person confirms.
  matchConfidence Int?
  note            String?
  ignoreReason    String?
  reconciledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id])
  account  BankAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  import   BankStatementImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)

  alerts BankAlertLog[]

  @@unique([companyId, fingerprint])
  @@index([companyId, status, txnDate])
  @@index([companyId, origin, txnDate])
  @@index([companyId, direction, txnDate])
  @@index([companyId, customerId])
  @@index([companyId, counterpartyKey])
}

/// What the app has learnt: this narration counterparty is this customer.
/// Written every time someone assigns a payment by hand, which is what
/// makes the second month of reconciliation far quicker than the first.
model BankMatchRule {
  id        String @id @default(uuid())
  companyId String

  counterpartyKey String
  customerId      String

  hits       Int      @default(1)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, counterpartyKey])
  @@index([companyId, customerId])
}

enum BankAlertStatus {
  BOOKED // became a transaction
  DUPLICATE // the same payment was already known
  IGNORED // not a payment, another account's, or not readable - reason says which
}

/// Every message posted to the ingest webhook, kept whatever happens to it.
/// A forwarded bank SMS that silently goes nowhere is worse than no
/// forwarding at all: without this row there is no way to answer "I got the
/// SMS, why isn't the payment in the app?".
model BankAlertLog {
  id        String @id @default(uuid())
  companyId String

  receivedAt DateTime @default(now())
  /// Sender id as the phone reported it, e.g. "AD-HDFCBK". Often the only
  /// thing that says which bank the message is about.
  sender     String?
  /// The message itself, trimmed. Kept so a parse that goes wrong can be
  /// diagnosed against the real wording rather than a guess at it.
  body       String

  status BankAlertStatus
  /// Why it wasn't booked, in the words shown back to whoever posted it.
  reason String?

  transactionId String?

  company     Company          @relation(fields: [companyId], references: [id])
  transaction BankTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([companyId, receivedAt])
  @@index([companyId, status, receivedAt])
}
