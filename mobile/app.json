{
  "expo": {
    "name": "M.L Orders",
    "slug": "ml-orders",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mlorders",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.mltraders.orders",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/splash.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
